<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_personal_awards_list" model="ir.ui.view">
        <field name="name">rm.personal.awards</field>
        <field name="model">rm.personal.awards</field>
        <field name="arch" type="xml">
            <list string="Personal Awards" sample="1">
                <field name="award_name"/>
                <field name="person_id"/>
                <field name="award_year"/>
                <field name="add_to_ribbon"/>
                <field name="add_to_big_medal"/>
                <field name="add_to_mini_medal"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_personal_awards_form" model="ir.ui.view">
        <field name="name">rm.personal.awards.form</field>
        <field name="model">rm.personal.awards</field>
        <field name="arch" type="xml">
            <form string="Personal Award">
                <sheet>
                    <group>
                        <field name="award_name"/>
                        <field name="person_id"/>
                        <field name="award_year"/>
                        <field name="add_to_ribbon"/>
                        <field name="add_to_big_medal"/>
                        <field name="add_to_mini_medal"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>





    <record id="action_personal_awards_acton" model="ir.actions.act_window">
        <field name="name">Personal Awards</field>
        <field name="res_model">rm.personal.awards</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a personal award</p>
            <p>Record of personal aawards</p>
        </field>
    </record>
</odoo>
