<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_acquisition_rules_list" model="ir.ui.view">
        <field name="name">rm.acquisition.rules.list</field>
        <field name="model">rm.acquisition.rules</field>
        <field name="arch" type="xml">
            <list string="Acquisition Rules">
                <field name="name"/>
                <field name="prb_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rm_acquisition_rules_form" model="ir.ui.view">
        <field name="name">rm.acquisition.rules.form</field>
        <field name="model">rm.acquisition.rules</field>
        <field name="arch" type="xml">
            <form string="Acquisition Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <field name="details" placeholder="Describe how this decoration is earned..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rm_acquisition_rules" model="ir.actions.act_window">
        <field name="name">Acquisition Rules</field>
        <field name="res_model">rm.acquisition.rules</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define an Award Acquisition Rule</p>
        </field>
    </record>
</odoo>
