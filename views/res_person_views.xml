<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_person_list" model="ir.ui.view">
        <field name="name">res.person.list</field>
        <field name="model">res.person</field>
        <field name="arch" type="xml">
            <list string="Personnel" sample="1">
                <field name="image_128" widget="image" class="oe_avatar" options="{'size': [24, 24]}" string=""/>
                <field name="id_number"/>
                <field name="name"/>
                <field name="rank_id"/>
                <field name="force_id" optional="show"/>
                <field name="current_workplace" optional="show"/>
                <field name="bcs_batch" optional="hide"/>
                <field name="service_confirmation_date" optional="hide"/>
                <field name="award_count" string="Awards" widget="badge" decoration-success="award_count &gt; 0"/>
            </list>
        </field>
    </record>

    <record id="view_res_person_form" model="ir.ui.view">
        <field name="name">res.person.form</field>
        <field name="model">res.person</field>
        <field name="arch" type="xml">
            <form string="Personnel Record">
                <field name="partner_id" invisible="1"/>
                <sheet>
                    <!--<div class="oe_button_box" name="button_box">
                        <button name="action_view_awards" type="object"
                                class="oe_stat_button" icon="fa-medkit">
                            <field name="award_count" widget="statinfo" string="Awards"/>
                        </button>
                    </div>-->
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Full Name"/>
                        <h1><field name="name" placeholder="e.g. Md. Rahim Uddin"/></h1>
                        <h3>
                            <field name="rank_id" placeholder="Rank" class="oe_inline"/>
                            <span invisible="not rank_id"> · </span>
                            <field name="force_id" readonly="1" class="oe_inline" placeholder="Force"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Service Information">
                            <field name="id_number"/>
                            <field name="current_workplace"/>
                            <field name="bcs_batch"/>
                            <field name="service_confirmation_date"/>
                            <field name="service_age" readonly="1"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="retirement_date"/>
                            <field name="is_retired" readonly="1"/>
                        </group>
                        <group string="Nameplate">
                            <field name="name_eng"/>
                            <field name="name_bng"/>
                        </group>
                        <group string="Contact">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Decorations" name="decorations">
                            <field name="obtained_awards_ids" widget="ribbon_rack" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="seniority_sequence"/>
                                    <field name="is_ribbon"/>
                                    <field name="is_medal"/>
                                    <field name="ribbon_image"/>
                                    <field name="medal_image"/>
                                </list>
                            </field>
                        </page>
                        <page string="Award" name="personal_awards">
                            <field name="personal_award_ledger_ids" nolabel="1">
                                <list>
                                    <field name="award_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Service" name="service">
                            <field name="service_ledger_ids" nolabel="1"
                                   >
                                <list >
                                    <field name="award_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Seniority" name="seniority">
                            <field name="seniority_ledger_ids" nolabel="1"
                                   options="{'create': false, 'delete': false, 'edit': false}">
                                <list create="false" delete="false" edit="false">
                                    <field name="award_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Customised" name="customised_ledger">
                            <div class="mb-2">
                                <button name="action_copy_ledger_to_custom" type="object"
                                        string="Copy from Ledger" class="btn-secondary"/>
                            </div>
                            <field name="custom_ledger_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="award_id"/>
                                    <field name="source"/>
                                    <field name="year"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_res_person_kanban" model="ir.ui.view">
        <field name="name">res.person.kanban</field>
        <field name="model">res.person</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="image_128"/>
                <field name="name"/>
                <field name="rank_id"/>
                <field name="force_id"/>
                <field name="current_workplace"/>
                <field name="award_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2">
                            <img t-att-src="kanban_image('res.person', 'image_128', record.id.raw_value)"
                                 class="o_kanban_image rounded-circle" alt="Photo" width="48" height="48"/>
                            <div class="flex-grow-1">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div t-if="record.rank_id.raw_value or record.force_id.raw_value" class="text-muted small">
                                    <field name="rank_id"/>
                                    <span t-if="record.rank_id.raw_value and record.force_id.raw_value"> · </span>
                                    <field name="force_id"/>
                                </div>
                                <div t-if="record.current_workplace.raw_value" class="text-muted small">
                                    <field name="current_workplace"/>
                                </div>
                                <div class="mt-1">
                                    <span class="badge text-bg-secondary">
                                        <field name="award_count"/> awards
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_res_person_search" model="ir.ui.view">
        <field name="name">res.person.search</field>
        <field name="model">res.person</field>
        <field name="arch" type="xml">
            <search string="Search Personnel">
                <field name="name"/>
                <field name="id_number"/>
                <field name="rank_id"/>
                <field name="force_id"/>
                <field name="current_workplace"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_force" string="Force" context="{'group_by': 'force_id'}"/>
                    <filter name="group_by_rank" string="Rank" context="{'group_by': 'rank_id'}"/>
                    <filter name="group_by_workplace" string="Current Workplace" context="{'group_by': 'current_workplace'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_person" model="ir.actions.act_window">
        <field name="name">Personnel</field>
        <field name="res_model">res.person</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_res_person_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Personnel Record</p>
            <p>Track personnel, their rank, force, and the decorations they've earned.</p>
        </field>
    </record>
</odoo>