<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_acquisition_list" model="ir.ui.view">
        <field name="name">rm.acquisition.list</field>
        <field name="model">rm.acquisition</field>
        <field name="arch" type="xml">
            <list string="Acquisition Ledger" create="false" edit="false" delete="false" sample="1">
                <field name="person_id"/>
                <field name="award_id"/>
                <field name="seniority_sequence" optional="hide"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'personal'"
                       decoration-success="source == 'mission'"
                       decoration-warning="source == 'seniority'"/>
                <field name="year" optional="show"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_rm_acquisition_search" model="ir.ui.view">
        <field name="name">rm.acquisition.search</field>
        <field name="model">rm.acquisition</field>
        <field name="arch" type="xml">
            <search string="Search Acquisition Ledger">
                <field name="person_id"/>
                <field name="award_id"/>
                <filter name="filter_personal" string="Personal Awards" domain="[('source', '=', 'personal')]"/>
                <filter name="filter_mission" string="Missions" domain="[('source', '=', 'mission')]"/>
                <filter name="filter_seniority" string="Seniority" domain="[('source', '=', 'seniority')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_person" string="Person" context="{'group_by': 'person_id'}"/>
                    <filter name="group_by_award" string="Award" context="{'group_by': 'award_id'}"/>
                    <filter name="group_by_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rm_acquisition" model="ir.actions.act_window">
        <field name="name">Acquisition Ledger</field>
        <field name="res_model">rm.acquisition</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_person': 1}</field>
        <field name="help" type="html">
            <p>Consolidated, read-only view of every award a person has
               actually acquired: Personal Awards, Missions, and
               Seniority-based awards (excluding anything listed under
               Excluded Awards).</p>
        </field>
    </record>
</odoo>