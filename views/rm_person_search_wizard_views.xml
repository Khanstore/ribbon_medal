<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_person_search_wizard_form" model="ir.ui.view">
        <field name="name">rm.person.search.wizard.form</field>
        <field name="model">rm.person.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Find or Create Person">
                <group>
                    <field name="deep_search"/>
                </group>
                <group invisible="deep_search">
                    <field name="search_term" placeholder="Search by name, ID, phone, mobile, email, rank, or unit..." nolabel="1"/>
                </group>
                <group invisible="not deep_search">
                    <field name="search_name" placeholder="Type a name..."/>
                    <field name="search_id_number" placeholder="Type an ID number..."/>
                    <field name="search_phone" placeholder="Type a phone number..."/>
                    <field name="search_mobile" placeholder="Type a mobile number..."/>
                    <field name="search_email" placeholder="Type an email..."/>
                    <field name="search_rank_id" placeholder="Pick a rank..."/>
                    <field name="search_unit_id" placeholder="Pick a unit..."/>
                </group>
                <field name="result_person_ids" readonly="1" nolabel="1">
                    <list>
                        <field name="name"/>
                        <field name="id_number"/>
                        <field name="phone"/>
                        <field name="mobile"/>
                        <field name="email"/>
                        <field name="rank_id"/>
                        <field name="current_workplace"/>
                    </list>
                </field>
                <group>
                    <field name="person_id"
                           placeholder="Pick the matching person from above, or leave blank to create new"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm &amp; Create Sale Order" class="btn-primary"
                            invisible="not person_id"/>
                    <button name="action_create_new_person" type="object"
                            string="No Match - Create New Person" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rm_person_search_wizard" model="ir.actions.act_window">
        <field name="name">Order Ribbon Rack</field>
        <field name="res_model">rm.person.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
