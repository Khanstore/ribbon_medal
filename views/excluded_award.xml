<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_excluded_awards_list" model="ir.ui.view">
        <field name="name">rm.excluded.awards</field>
        <field name="model">rm.excluded.awards</field>
        <field name="arch" type="xml">
            <list string="Excluded Awards" sample="1">
                <field name="decoration_name"/>
                <field name="person_id"/>
                <field name="exclusion_year"/>
                <field name="reason"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_excluded_awards_form" model="ir.ui.view">
        <field name="name">rm.excluded.awards.form</field>
        <field name="model">rm.excluded.awards</field>
        <field name="arch" type="xml">
            <form string="Excluded Award">
                <sheet>
                    <group>
                        <field name="decoration_name"/>
                        <field name="person_id"/>
                        <field name="exclusion_year"/>
                        <field name="reason"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_excluded_awards_search" model="ir.ui.view">
        <field name="name">rm.excluded.awards.search</field>
        <field name="model">rm.excluded.awards</field>
        <field name="arch" type="xml">
            <search string="Search Excluded Awards">
                <field name="decoration_name"/>
                <field name="person_id"/>
                <field name="reason"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_person" string="Person" context="{'group_by': 'person_id'}"/>
                    <filter name="group_by_award" string="Award" context="{'group_by': 'decoration_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_excluded_awards_acton" model="ir.actions.act_window">
        <field name="name">Excluded Awards</field>
        <field name="res_model">rm.excluded.awards</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record an excluded award</p>
            <p>Awards withheld, revoked, or otherwise excluded from a person's record.</p>
        </field>
    </record>
</odoo>
