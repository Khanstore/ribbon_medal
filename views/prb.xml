<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_rm_prb_tree" model="ir.ui.view">
        <field name="name">rm.prb.tree</field>
        <field name="model">rm.prb</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="medal_id"/>
                <field name="ribbon_id"/>
                <field name="force_id"/>
                <field name="sequence"/>
                <field name="starting_date"/>
                <field name="mission_name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_rm_prb_form" model="ir.ui.view">
        <field name="name">rm.prb.form</field>
        <field name="model">rm.prb</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="medal_id" domain="[('is_medal', '=', True)]"/>
                            <field name="ribbon_id" domain="[('is_ribbon', '=', True)]"/>
                            <field name="force_id"/>
                            <field name="rule_category_id"/>
                            <field name="mission_name"/>
                        </group>
                        <group>
                            <field name="starting_date"/>
                            <field name="sequence"/>
                            <field name="service_age"/>
                            <field name="is_ribbon"/>
                            <field name="is_medal"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="ribbon_image" widget="image" class="oe_avatar"/>
                        <field name="medal_image" widget="image" class="oe_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_rm_prb_kanban" model="ir.ui.view">
        <field name="name">rm.prb.kanban</field>
        <field name="model">rm.prb</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="medal_id"/>
                <field name="ribbon_id"/>
                <field name="force_id"/>
                <field name="mission_name"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <strong><field name="name"/></strong>
                            <div t-if="record.medal_id.raw_value">Medal: <field name="medal_id"/></div>
                            <div t-if="record.ribbon_id.raw_value">Ribbon: <field name="ribbon_id"/></div>
                            <div t-if="record.force_id.raw_value">Force: <field name="force_id"/></div>
                            <div t-if="record.mission_name.raw_value">Mission: <field name="mission_name"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rm_prb" model="ir.actions.act_window">
        <field name="name">PRB of Decorations</field>
        <field name="res_model">rm.prb</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>