<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_medal_part_list" model="ir.ui.view">
        <field name="name">rm.medal.part.list</field>
        <field name="model">rm.medal.part</field>
        <field name="arch" type="xml">
            <list string="Medal Parts">
                <field name="display_identity"/>
                <field name="size"/>
                <field name="stock_count"/>
                <field name="use_count"/>
                <field name="last_used_date"/>
                <field name="bom_incomplete" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_rm_medal_part_form" model="ir.ui.view">
        <field name="name">rm.medal.part.form</field>
        <field name="model">rm.medal.part</field>
        <field name="arch" type="xml">
            <form string="Medal Part">
                <div class="alert alert-warning" role="alert"
                     invisible="not bom_incomplete">
                    This Part's BOM could not fully auto-resolve (e.g. one of
                    its awards' Ribbon has no variant at this size). Review
                    its Bill of Materials manually.
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_identity" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="identity_key" readonly="1"/>
                            <field name="size" readonly="1"/>
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="bom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="stock_count" readonly="1"/>
                            <field name="use_count" readonly="1"/>
                            <field name="last_used_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Awards" name="awards">
                            <field name="award_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="award_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stock Units" name="units">
                            <field name="unit_ids">
                                <list>
                                    <field name="state"/>
                                    <field name="mrp_production_id"/>
                                    <field name="mo_state"/>
                                    <field name="consumed_note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rm_medal_part" model="ir.actions.act_window">
        <field name="name">Medal Parts</field>
        <field name="res_model">rm.medal.part</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Medal Parts appear here automatically as new medal-eligible
                award combinations get their ribbon mount built
            </p>
        </field>
    </record>
</odoo>
