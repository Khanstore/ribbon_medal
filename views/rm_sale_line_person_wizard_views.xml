<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_sale_line_person_wizard_form" model="ir.ui.view">
        <field name="name">rm.sale.line.person.wizard.form</field>
        <field name="model">rm.sale.line.person.wizard</field>
        <field name="arch" type="xml">
            <form string="Configure Rack Person and Deposited Medals">
                <field name="line_id" invisible="1"/>
                <field name="order_id" invisible="1"/>
                <field name="rack_type" invisible="1"/>
                <p>
                    Choose the person for this rack. When editing an existing rack line, Confirm updates that same line; it does not add a duplicate. Deposited quantities are restored from the saved line and affect pricing/manufacturing only.
                </p>
                <group>
                    <field name="search_term" widget="rm_live_search"
                           placeholder="Search by name, ID, phone, mobile, email, rank, or unit..."/>
                </group>
                <field name="result_person_ids" nolabel="1" readonly="1"
                       invisible="not search_term">
                    <list limit="20" create="false" delete="false">
                        <field name="name"/>
                        <field name="id_number"/>
                        <field name="rank_id"/>
                        <field name="current_workplace"/>
                        <field name="phone"/>
                        <button name="action_select_for_rack_wizard" type="object"
                                string="Select" class="btn-link"
                                context="{'rack_wizard_id': parent.id}"/>
                    </list>
                </field>
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1 pe-3">
                        <group>
                            <field name="person_id"
                                   placeholder="...or type/search directly here"/>
                            <field name="rack_total_price" invisible="not person_id" readonly="1"/>
                        </group>
                        <group invisible="rack_type == 'ribbon' or not person_id"
                               string="Customer-Deposited Medals">
                            <div class="o_form_label">Enter the quantity the customer supplies for each medal. Use 0 when the shop supplies it.</div>
                            <field name="deposit_line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="award_id" force_save="1"/>
                                    <field name="max_quantity" readonly="1" string="Acquired Qty"/>
                                    <field name="quantity" string="Qty Deposited"/>
                                </list>
                            </field>
                        </group>
                    </div>
                    <div class="text-center flex-shrink-0" style="min-width: 200px;"
                         invisible="not person_id">
                        <div class="mb-2">
                            <label for="rack_quantity" class="form-label fw-bold">Rack Qty</label>
                            <field name="rack_quantity" nolabel="1" class="oe_inline"
                                   style="max-width: 110px; text-align: center;"/>
                        </div>
                        <field name="rack_preview_image" widget="image" nolabel="1"
                               class="oe_avatar" options="{'size': [200, 200]}"/>
                        <div class="text-muted small mt-1" invisible="rack_preview_image">
                            No rack image yet for this combination
                        </div>
                    </div>
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="not person_id"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
