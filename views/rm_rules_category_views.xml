<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_rules_category_list" model="ir.ui.view">
        <field name="name">rm.rules.category.list</field>
        <field name="model">rm.rules.category</field>
        <field name="arch" type="xml">
            <list string="Rules Category">
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rm_rules_category_form" model="ir.ui.view">
        <field name="name">rm.rules.category.form</field>
        <field name="model">rm.rules.category</field>
        <field name="arch" type="xml">
            <form string="Rule Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <field name="details" placeholder="Describe how this decoration is earned..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rm_rules_category" model="ir.actions.act_window">
        <field name="name">Acquisition Rules Category</field>
        <field name="res_model">rm.rules.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a Category Award Acquisition Rules</p>
        </field>
    </record>
</odoo>
