<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_acquisition_custom_list" model="ir.ui.view">
        <field name="name">rm.acquisition.custom.list</field>
        <field name="model">rm.acquisition.custom</field>
        <field name="arch" type="xml">
            <list string="Customised Acquisition Ledger" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="person_id"/>
                <field name="award_id"/>
                <field name="source"/>
                <field name="year"/>
                <field name="attachment_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_rm_acquisition_custom_form" model="ir.ui.view">
        <field name="name">rm.acquisition.custom.form</field>
        <field name="model">rm.acquisition.custom</field>
        <field name="arch" type="xml">
            <form string="Customised Ledger Entry">
                <sheet>
                    <group>
                        <field name="person_id"/>
                        <field name="award_id"/>
                        <field name="source"/>
                        <field name="sequence"/>
                        <field name="year"/>
                        <field name="attachment_id"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rm_acquisition_custom_search" model="ir.ui.view">
        <field name="name">rm.acquisition.custom.search</field>
        <field name="model">rm.acquisition.custom</field>
        <field name="arch" type="xml">
            <search string="Search Customised Ledger">
                <field name="person_id"/>
                <field name="award_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_person" string="Person" context="{'group_by': 'person_id'}"/>
                    <filter name="group_by_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rm_acquisition_custom" model="ir.actions.act_window">
        <field name="name">Customised Ledgers</field>
        <field name="res_model">rm.acquisition.custom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customised ledgers yet</p>
            <p>Use the "Copy from Ledger" button on a Personnel record to snapshot
               their Acquisition Ledger here, then reorder/edit freely - it won't
               change automatically afterwards.</p>
        </field>
    </record>
</odoo>
