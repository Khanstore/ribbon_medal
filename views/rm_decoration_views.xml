<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_decoration_list" model="ir.ui.view">
        <field name="name">rm.decoration.list</field>
        <field name="model">rm.decoration</field>
        <field name="arch" type="xml">
            <list string="Decorations">
                <field name="decoration_name"/>
                <field name="is_ribbon"/>
                <field name="is_medal"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rm_decoration_form" model="ir.ui.view">
        <field name="name">rm.decoration.form</field>
        <field name="model">rm.decoration</field>
        <field name="arch" type="xml">
            <form string="Decoration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_res_person)d" type="action"
                                class="oe_stat_button" icon="fa-users">
                        </button>
                        <button name="action_view_ribbon_product" type="object"
                                class="oe_stat_button" icon="fa-tag"
                                invisible="not ribbon_product_tmpl_id">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Ribbon Product</span>
                            </div>
                        </button>
                        <button name="action_view_medal_product" type="object"
                                class="oe_stat_button" icon="fa-tag"
                                invisible="not medal_product_tmpl_id">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Medal Product</span>
                            </div>
                        </button>
                        <button name="action_regenerate_rack_images" type="object"
                                class="oe_stat_button" icon="fa-refresh"
                                invisible="not ribbon_image and not medal_image">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Update</span>
                                <span class="o_stat_text">Rack Images</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="decoration_name"/>
                        <h1><field name="decoration_name" placeholder="Award name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="attachment_id"/>
                            <field name="mission_name"/>
                        </group>
                        <group>
                            <field name="is_ribbon"/>
                            <field name="is_medal"/>
                            <field name="active" invisible="1"/>
                            <field name="ribbon_product_tmpl_id" invisible="1"/>
                            <field name="medal_product_tmpl_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Images">
                            <group>
                                <field name="ribbon_image" widget="image"
                                       invisible="not is_ribbon"/>
                                <field name="medal_image" widget="image"
                                       invisible="not is_medal"/>
                            </group>
                            <p class="text-muted">
                                Uploading a new image here only affects Racks built from
                                now on. Racks already built with this Decoration keep
                                their own stored picture - use the
                                <strong>Update Rack Images</strong> button above to push
                                this change out to every Rack already built with it.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rm_decoration_search" model="ir.ui.view">
        <field name="name">rm.decoration.search</field>
        <field name="model">rm.decoration</field>
        <field name="arch" type="xml">
            <search string="Search Decorations">
                <field name="decoration_name"/>
                <field name="mission_name"/>
                <filter name="filter_ribbon" string="Ribbons" domain="[('is_ribbon', '=', True)]"/>
                <filter name="filter_medal" string="Medals" domain="[('is_medal', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_rm_decoration" model="ir.actions.act_window">
        <field name="name">Decorations</field>
        <field name="res_model">rm.decoration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Ribbon or Medal</p>
        </field>
    </record>
</odoo>
