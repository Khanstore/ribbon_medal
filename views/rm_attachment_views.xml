<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_attachment_list" model="ir.ui.view">
        <field name="name">rm.attachment.list</field>
        <field name="model">rm.attachment</field>
        <field name="arch" type="xml">
            <list string="Attachments (Club / Numeral Devices)">
                <field name="name"/>
                <field name="force_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rm_attachment_form" model="ir.ui.view">
        <field name="name">rm.attachment.form</field>
        <field name="model">rm.attachment</field>
        <field name="arch" type="xml">
            <form string="Attachment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_device_product" type="object"
                                class="oe_stat_button" icon="fa-tag"
                                invisible="not device_product_tmpl_id">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Device Product</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Bronze Star, Numeral 2"/></h1>
                    </div>
                    <group>
                        <field name="force_id"/>
                        <field name="active" invisible="1"/>
                        <field name="device_product_tmpl_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rm_attachment_search" model="ir.ui.view">
        <field name="name">rm.attachment.search</field>
        <field name="model">rm.attachment</field>
        <field name="arch" type="xml">
            <search string="Search Attachments">
                <field name="name"/>
                <field name="force_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_force" string="Force" context="{'group_by': 'force_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rm_attachment" model="ir.actions.act_window">
        <field name="name">Attachments</field>
        <field name="res_model">rm.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an Attachment (club / numeral device)</p>
            <p>Devices worn on a ribbon or medal to indicate repeat awards, campaigns, etc.</p>
        </field>
    </record>
</odoo>
