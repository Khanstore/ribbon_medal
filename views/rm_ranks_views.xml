<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_ranks_list" model="ir.ui.view">
        <field name="name">rm.ranks.list</field>
        <field name="model">rm.ranks</field>
        <field name="arch" type="xml">
            <list string="Ranks">
                <field name="code"/>
                <field name="name"/>
                <field name="force_id"/>
                <field name="seniority_level"/>
                <field name="person_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rm_ranks_form" model="ir.ui.view">
        <field name="name">rm.ranks.form</field>
        <field name="model">rm.ranks</field>
        <field name="arch" type="xml">
            <form string="Rank">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Rank name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="force_id"/>
                        </group>
                        <group>
                            <field name="seniority_level"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rm_ranks_search" model="ir.ui.view">
        <field name="name">rm.ranks.search</field>
        <field name="model">rm.ranks</field>
        <field name="arch" type="xml">
            <search string="Search Ranks">
                <field name="name"/>
                <field name="code"/>
                <field name="force_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_force" string="Force" context="{'group_by': 'force_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rm_ranks" model="ir.actions.act_window">
        <field name="name">Ranks</field>
        <field name="res_model">rm.ranks</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Rank</p>
        </field>
    </record>
</odoo>
