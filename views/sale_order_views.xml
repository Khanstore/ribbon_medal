<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ribbon_medal" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ribbon.medal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_manufacturing_orders" type="object"
                        class="oe_stat_button" icon="fa-industry"
                        invisible="mrp_production_count == 0">
                    <field name="mrp_production_count" widget="statinfo" string="Manufacturing Orders"/>
                </button>
                <button name="action_view_rack_units" type="object"
                        class="oe_stat_button" icon="fa-flask"
                        invisible="not rack_unit_id and not tunic_medal_rack_unit_id and not meskit_medal_rack_unit_id">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Rack Unit</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="person_id"/>
                <field name="rack_unit_id" invisible="1"/>
                <field name="tunic_medal_rack_unit_id" invisible="1"/>
                <field name="meskit_medal_rack_unit_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <div class="d-flex gap-2 mb-2">
                    <button name="action_print_rack_report" type="object"
                            string="Print Rack Report" class="btn-primary"
                            icon="fa-print" invisible="not has_rack_lines"/>
                    <field name="has_rack_lines" invisible="1"/>
                    <field name="mrp_production_count" invisible="1"/>
                </div>
                <div class="d-flex gap-2 mb-2">
                    <button name="action_add_ribbon_rack_line" type="object"
                            string="Add Ribbon Rack Line" class="btn-secondary"
                            icon="fa-plus"/>
                    <button name="action_add_tunic_medal_rack_line" type="object"
                            string="Tunic Medal Rack" class="btn-secondary"
                            icon="fa-plus"/>
                    <button name="action_add_meskit_medal_rack_line" type="object"
                            string="Meskit Medal Rack" class="btn-secondary"
                            icon="fa-plus"/>
                </div>
            </xpath>
            <!-- Odoo 18 renders sale.order.order_line as a <list>. Keep the
                 target explicit and put the technical flag in the same list
                 so the row button has a reliable visibility value. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="rack_type" column_invisible="1"/>
                <field name="person_id" column_invisible="1"/>
                <field name="is_rack_line" column_invisible="1"/>
                <button name="action_open_person_wizard" type="object"
                        class="btn btn-link"
                        icon="fa-user"
                        invisible="not is_rack_line"
                        title="Edit rack person and deposited-medal quantities"/>
            </xpath>
        </field>
    </record>

    <!-- Adds the order's own Order Date right after Order Reference on
         the standard sale.order.line list view - used by the Person
         form's "Ordered Racks" / "Racks Not Delivered" smart buttons
         (see rm_sale_line_action_views() context in res_partner.py for
         the default group-by-Order that goes with this). Inheriting
         the shared view (rather than a bespoke one) keeps this in sync
         with whatever else already renders correctly here. -->
    <record id="view_order_line_tree_rm_order_date" model="ir.ui.view">
        <field name="name">sale.order.line.tree.rm.order.date</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="order_date"/>
            </field>
        </field>
    </record>
</odoo>
