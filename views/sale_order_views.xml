<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ribbon_medal" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ribbon.medal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="%(action_rm_rack_unit_pending)d" type="action"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not rack_unit_id or rack_unit_id_state == 'delivered'">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Awaiting Delivery</span>
                    </div>
                </button>
                <button name="action_open_rack_unit" type="object"
                        class="oe_stat_button" icon="fa-flask"
                        invisible="not rack_unit_id">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Rack Unit</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="person_id"/>
                <field name="rack_unit_id" invisible="1"/>
                <field name="rack_unit_id_state" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="before">
                <button name="action_add_ribbon_rack_line" type="object"
                        string="Add Ribbon Rack Line" class="btn-secondary mb-2"
                        icon="fa-plus"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
                <field name="is_ribbon_rack_line" column_invisible="1"/>
                <field name="person_id" column_invisible="1"/>
                <button name="action_open_person_wizard" type="object"
                        icon="fa-user"
                        invisible="not is_ribbon_rack_line"
                        title="Select Person"/>
            </xpath>
        </field>
    </record>
</odoo>
