<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Every Ribbon/Tunic/Meskit rack line sells the same generic
         product, so two different people's lines on one delivery look
         identical by product name alone. This surfaces which specific
         manufactured instance (e.g. "Rack #6") each line actually is. -->
    <record id="view_picking_form_rm_rack_instance" model="ir.ui.view">
        <field name="name">stock.picking.form.rm.rack.instance</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- product_id is still the real, functional field (needed
                 for stock accounting/valuation) - just hidden from this
                 particular list, since rm_rack_instance_name now takes
                 over the "Product" column slot with the more useful,
                 line-distinguishing text instead. -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">
                <field name="rm_rack_instance_name"/>
            </xpath>
        </field>
    </record>

</odoo>
