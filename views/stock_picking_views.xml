<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ribbon_medal_sale_order" model="ir.ui.view">
        <field name="name">stock.picking.form.ribbon.medal.sale.order</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sale_order_ref_id" readonly="1" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_picking_internal_search_ribbon_medal_sale_order" model="ir.ui.view">
        <field name="name">stock.picking.search.ribbon.medal.sale.order</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sale_order_ref_id" string="Sale Order" filter_domain="[('sale_order_ref_id.name', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>
