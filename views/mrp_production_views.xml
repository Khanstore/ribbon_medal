<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds an optional "Racks Only" filter to the standard
         Manufacturing > Orders search view. Left off by default (the
         default Manufacturing Orders list is unchanged) - toggling it
         on narrows the list to just the finished Rack/Medal Rack
         assembly MOs (rm_is_finished_rack on their product), hiding
         the Rack Line / Medal Part component MOs along the way. -->
    <record id="view_mrp_production_filter_rm_racks_only" model="ir.ui.view">
        <field name="name">mrp.production.select.rm.racks.only</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Racks Only" name="rm_racks_only"
                        domain="[('product_id.product_tmpl_id.rm_is_finished_rack', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- The cascading "Produce All" behavior lives directly on the
         standard button now (see MrpProduction.button_mark_done in
         mrp_production.py) - no separate view/button needed here. -->

</odoo>
