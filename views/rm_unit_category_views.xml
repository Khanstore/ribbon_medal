<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rm_unit_category_list" model="ir.ui.view">
        <field name="name">rm.unit.category.list</field>
        <field name="model">rm.unit.category</field>
        <field name="arch" type="xml">
            <list string="Unit Categories">
                <field name="name"/>
                <field name="force_id"/>
                <field name="parent_id"/>
                <field name="chief_id"/>
<!--                <field name="unit_count"/>-->
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rm_unit_category_form" model="ir.ui.view">
        <field name="name">rm.unit.category.form</field>
        <field name="model">rm.unit.category</field>
        <field name="arch" type="xml">
            <form string="Unit Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object"
                                class="oe_stat_button" icon="fa-building">
<!--                            <field name="unit_count" widget="statinfo" string="Units"/>-->
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Battalion, Wing, Division"/></h1>
                    </div>
                    <group>
                        <field name="level"/>
                        <field name="force_id"/>
                        <field name="parent_id"/>
                        <field name="chief_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rm_unit_category_search" model="ir.ui.view">
        <field name="name">rm.unit.category.search</field>
        <field name="model">rm.unit.category</field>
        <field name="arch" type="xml">
            <search string="Search Unit Categories">
                <field name="name"/>
                <field name="force_id"/>
                <field name="level"/>
                <field name="chief_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_force" string="Force" context="{'group_by': 'force_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rm_unit_category" model="ir.actions.act_window">
        <field name="name">Unit Categories</field>
        <field name="res_model">rm.unit.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Unit Category</p>
        </field>
    </record>
</odoo>
